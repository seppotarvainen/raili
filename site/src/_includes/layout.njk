<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} — Raili</title>
  {%- set root = base | default('') -%}
  <link rel="stylesheet" href="{{ root }}/assets/style.css">
</head>
<body>
  <nav class="sidebar">
    <a href="{{ root }}/" class="logo">Raili</a>
    <img src="https://img.shields.io/npm/v/%40seppotarvainen%2Fraili" alt="npm version">
    <ul>
      <li><a href="{{ root }}/">Home</a></li>
      <li><a href="{{ root }}/quickstart/">Quickstart</a></li>
      <li><a href="{{ root }}/examples/">Examples</a></li>
    </ul>
    <h3>Documentation</h3>
    <ul>
      {%- for doc in collections.docs %}
      <li><a href="{{ root }}/docs/{{ doc.slug }}/">{{ doc.title }}</a></li>
      {%- endfor %}
    </ul>
    <h3>Usage</h3>
    <ul>
      {%- for doc in collections.usage %}
      <li><a href="{{ root }}/usage/{{ doc.slug }}/">{{ doc.title }}</a></li>
      {%- endfor %}
    </ul>
  </nav>
  <main>
    {{ content | safe }}
  </main>
</body>
</html>

